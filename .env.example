# ---- Server ----
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Comma separated frontend origins. Wildcards allowed, e.g. https://*.vercel.app
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ---- Database (hosted MongoDB, e.g. Atlas) ----
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hcm_lite

# ---- First run (optional) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
COMPANY_NAME=

# ---- AI assistant (any OpenAI-compatible API with tool calling) ----
AI_PROVIDER=openrouter
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_TIMEOUT_MS=15000
AI_HOURLY_LIMIT=20
